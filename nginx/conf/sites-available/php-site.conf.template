server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name example.local;
    set $base /var/www/html/example;
    root $base/public;
    index index.php;

    access_log /dev/stdout;
    error_log /dev/stdout info;

    ssl_certificate /etc/nginx/certs/example.local.crt;
    ssl_certificate_key /etc/nginx/certs/example.local.key;

    location ~ \.php$ {
        include snippets/php.conf;
        include snippets/php-upstream-84.conf;
        fastcgi_param PHP_ADMIN_VALUE "open_basedir=$base/:/usr/lib/php/:/tmp/:/var/www/html";
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
}
