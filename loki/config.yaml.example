# Loki single-binary config for single-VM deployment.
#
# Filesystem chunk storage + tsdb index. No object storage, no replication.
# Suitable for ~1k-10k log lines/sec on a single host. When/if traffic grows
# past that, swap chunks_directory to S3/R2 and add a separate ingester.
#
# Retention: 90 days globally, with `stream=ops` overridden to 30 days.
# Compactor enforces retention; chunks are deleted 2 hours after the
# retention boundary to give in-flight queries time to finish.

auth_enabled: false

server:
  http_listen_port: 3100
  grpc_listen_port: 9096
  log_level: info

common:
  path_prefix: /loki
  storage:
    filesystem:
      chunks_directory: /loki/chunks
      rules_directory: /loki/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

schema_config:
  configs:
    - from: 2024-01-01
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

limits_config:
  retention_period: 90d
  retention_stream:
    - selector: '{stream="ops"}'
      priority: 1
      period: 30d
  # Guardrails — keep cardinality bounded
  max_label_name_length: 1024
  max_label_value_length: 2048
  max_label_names_per_series: 30
  ingestion_rate_mb: 8
  ingestion_burst_size_mb: 16

compactor:
  working_directory: /loki/compactor
  retention_enabled: true
  retention_delete_delay: 2h
  retention_delete_worker_count: 10
  delete_request_store: filesystem

ruler:
  storage:
    type: local
    local:
      directory: /loki/rules
  rule_path: /loki/rules-temp
  ring:
    kvstore:
      store: inmemory
  enable_api: true

analytics:
  reporting_enabled: false
