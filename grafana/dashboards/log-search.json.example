      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (stream) (count_over_time({stream=~\"$stream\"} |= \"$search\" [1m]))",
          "legendFormat": "{{stream}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Log volume / min",
      "type": "timeseries"
    },
    {
