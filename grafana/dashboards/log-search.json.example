      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{stream=~\"$stream\"} |= \"$search\" | json | drop __error__, __error_details__",
          "maxLines": 500,
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Logs — $stream | \"$search\"",
      "type": "logs"
    },
