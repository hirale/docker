      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({stream=~\"$stream\"} |~ \"(?i)(error|fatal|critical)\" [$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Error / Fatal / Critical",
      "type": "stat"
    },
