      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({stream=~\"$stream\"} |= \"$search\" [$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Matching search",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Lines containing error, fatal, or critical (case-insensitive).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
