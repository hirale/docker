# Prometheus datasource — provisioned alongside Loki. Stable UID `prometheus`
# so dashboard JSONs can reference it portably.

apiVersion: 1

datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: false
    editable: false
    jsonData:
      timeInterval: 30s
      httpMethod: POST
