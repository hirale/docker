# Pre-configured Loki datasource. Provisioned on first boot, kept in sync
# on every Grafana restart. Edits made via the Grafana UI to a provisioned
# datasource are reverted on restart — change this file instead.

apiVersion: 1

datasources:
  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: http://loki:3100
    isDefault: true
    editable: false
    jsonData:
      maxLines: 1000
      timeout: 60
