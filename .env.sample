# php
PHP_VERSION=8.4.8
MAILPIT_BINARY_VERSION=1.29.3
MAILPIT_VERSION_IMAGE=v1.29.3

# mariadb
MARIADB_VERSION=10.11.6
MARIADB_DATABASE=database1
MARIADB_USER=database1
MARIADB_PASSWORD=password
MARIADB_ROOT_PASSWORD=password
MARIADB_TZ=Asia/Shanghai
MARIADB_DATA_DIR=./mysql

# db helper script (optional)
# DB_TOOL_USER=root
# DB_TOOL_PASSWORD=password
# DB_DEFAULT_USER_PASSWORD=change-me

# nginx
NGINX_VERSION=1.27.4
WEB_ROOT=/your/projects/path
NGINX_CONFIG=./nginx/conf

# php config
PHP_CONFIG=./php-fpm/conf

# pinned service images
REDIS_VERSION=7.2.13-alpine3.21
OFELIA_VERSION=0.3.21

# ofelia
DOCKER_SOCKET=/var/run/docker.sock
OFELIA_CONFIG=./config.ini
