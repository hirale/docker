# ==============================================================================
# Core services
# ==============================================================================

# PHP
PHP_VERSION=8.4.8
MAILPIT_BINARY_VERSION=1.29.3
MAILPIT_VERSION_IMAGE=v1.29.3
NODE_MAJOR=22

# MySQL
MYSQL_VERSION=10.11.6
MYSQL_DATABASE=database1
MYSQL_USER=database1
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=password
MYSQL_TZ=Asia/Shanghai
MYSQL_DATA_DIR=./mysql

# Nginx
NGINX_VERSION=1.27.4
WEB_ROOT=/your/projects/path
NGINX_CONFIG=./nginx/

# PHP config
PHP_CONFIG=./php-fpm/conf

# Pinned service images
REDIS_VERSION=7.2.13-alpine3.21
OFELIA_VERSION=0.3.21

# Ofelia
DOCKER_SOCKET=/var/run/docker.sock
OFELIA_CONFIG=./config.ini

# DB helper script (optional)
# DB_TOOL_USER=root
# DB_TOOL_PASSWORD=password
# DB_DEFAULT_USER_PASSWORD=change-me
# DB_IMPORT_SERVER_MAX_ALLOWED_PACKET=1073741824
# DB_IMPORT_CLIENT_MAX_ALLOWED_PACKET=1G
# DB_IMPORT_CLIENT_NET_BUFFER_LENGTH=1M
# DB_IMPORT_NET_READ_TIMEOUT=600
# DB_IMPORT_NET_WRITE_TIMEOUT=600
# DB_COPY_IGNORE_TABLES=logs,audit_events

# ==============================================================================
# Observability (optional)
# Enable: docker compose -f compose.yml -f compose.observability.yml up -d
# ==============================================================================

# Loki + Alloy + Grafana
LOKI_VERSION=3.3.0
ALLOY_VERSION=v1.5.0
GRAFANA_VERSION=11.4.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-first-boot
GRAFANA_ROOT_URL=https://grafana.example.com/

# Prometheus + Exporters
PROMETHEUS_VERSION=v3.0.0
MYSQLD_EXPORTER_VERSION=v0.15.1
REDIS_EXPORTER_VERSION=v1.66.0
NGINX_EXPORTER_VERSION=1.4.0

# GlitchTip (Sentry-protocol error tracking)
GLITCHTIP_VERSION=v4.0
GLITCHTIP_POSTGRES_VERSION=16-alpine
GLITCHTIP_POSTGRES_PASSWORD=change-me-before-first-boot
GLITCHTIP_SECRET_KEY=change-me-50-random-chars
GLITCHTIP_DEFAULT_FROM_EMAIL=noreply@myproject.example.com
GLITCHTIP_EMAIL_URL=smtp://mailpit:1025
GLITCHTIP_ENABLE_OPEN_USER_REGISTRATION=true
BACKEND_GLITCHTIP_DSN=
FRONTEND_GLITCHTIP_DSN=
