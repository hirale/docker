# Prometheus config — single-VM scrape config.
#
# Retention is 15d (set via --storage.tsdb.retention.time on the service).
# Scrape interval 30s is enough for ops dashboards; bring it down to 15s
# if you need finer-grain alerting.

global:
  scrape_interval: 30s
  evaluation_interval: 30s
  external_labels:
    cluster: myapp-dev
    project: myapp

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: mysql
    static_configs:
      - targets: ['mysqld-exporter:9104']

  - job_name: redis
    static_configs:
      - targets: ['redis-exporter:9121']

  - job_name: nginx
    static_configs:
      - targets: ['nginx-exporter:9113']

  - job_name: phpfpm
    static_configs:
      - targets: ['phpfpm-exporter:9253']

  - job_name: alloy
    static_configs:
      - targets: ['alloy:12345']

  - job_name: loki
    static_configs:
      - targets: ['loki:3100']

  - job_name: grafana
    static_configs:
      - targets: ['grafana:3000']
    metrics_path: /metrics
