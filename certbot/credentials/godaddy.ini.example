# GoDaddy DNS-01 credentials for certbot-dns-multi.
# Copy this file to godaddy.ini and fill in your keys.
# Generate keys at: https://developer.godaddy.com/keys
#
# Note: GoDaddy DNS propagation is slow. Recommended propagation >= 600s.
#
# Usage: make ssl-issue DOMAIN=example.com EMAIL=you@email.com CRED=godaddy

dns_multi_provider = godaddy
GODADDY_API_KEY = your-godaddy-api-key
GODADDY_API_SECRET = your-godaddy-api-secret
