# DigitalOcean DNS-01 credentials for certbot-dns-multi.
# Copy this file to digitalocean.ini and fill in your token.
# Generate token at: https://cloud.digitalocean.com/account/api/tokens
#
# Usage: make ssl-issue DOMAIN=example.com EMAIL=you@email.com CRED=digitalocean

dns_multi_provider = digitalocean
DO_AUTH_TOKEN = your-digitalocean-token-here
