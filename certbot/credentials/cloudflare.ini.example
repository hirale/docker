# Cloudflare DNS-01 credentials for certbot-dns-multi.
# Copy this file to cloudflare.ini and fill in your token.
# Token needs Zone:DNS:Edit permission.
#
# Usage: make ssl-issue DOMAIN=example.com EMAIL=you@email.com CRED=cloudflare

dns_multi_provider = cloudflare
CLOUDFLARE_DNS_API_TOKEN = your-api-token-here
