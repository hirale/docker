# Porkbun DNS-01 credentials for certbot-dns-multi.
# Copy this file to porkbun.ini and fill in your keys.
# Enable API access per-domain in Porkbun dashboard.
#
# Usage: make ssl-issue DOMAIN=example.com EMAIL=you@email.com CRED=porkbun

dns_multi_provider = porkbun
PORKBUN_API_KEY = your-porkbun-api-key
PORKBUN_SECRET_API_KEY = your-porkbun-secret-api-key
